#[display_name = "Ruby"]
#[line_comment = "#"]
#[path = "**/*.rb"]
#[path = "**/*.rake"]
#[path = "**/*.ru"]
#[path = "**/Gemfile"]
#[path = "**/Rakefile"]
#[shebang = "ruby"]
pub fn ruby() {
    var zero = 0;
    var one = 1;
    var heredoc = 0;

    until /$/ {
        yield other;

        if off == zero {
            if /=begin\>/ {
                loop {
                    yield comment;
                    await input;
                    if off == zero {
                        if /=end\>/ {
                            yield comment;
                            break;
                        }
                    }
                }
                continue;
            }
        }

        if /<<[~-]?['"]?([A-Z_][A-Za-z0-9_]*)['"]?/ {
            // Heredoc opener. The rest of this line is ordinary code; the
            // body starts on the next one, so only note it for now.
            yield string;
            save $1;
            heredoc = 1;
        } else {
            ruby_token();
        }

        yield other;
    }

    if heredoc == one {
        loop {
            await input;
            if /[ \t]*/ {}
            if $saved {
                if /$/ {
                    yield other;
                    break;
                }
            }
            if /.*/ {}
            yield string;
        }
    }
}

// One token of Ruby, shared by erb.lsh (which must stop mid-line at "%>").
// Heredocs stay in ruby(), which needs a caller-local flag this can't hold.
fn ruby_token() {
    if /#.*/ {
        yield comment;
    } else if /%[wWiIqQrxs]\[[^\]]*\]/ {
        yield string;
    } else if /%[wWiIqQrxs]\([^)]*\)/ {
        yield string;
    } else if /%[wWiIqQrxs]\{[^}]*\}/ {
        yield string;
    } else if /%[wWiIqQrxs]<[^>]*>/ {
        yield string;
    } else if /\?(?:\\[a-zA-Z0-9\\'"]|[A-Za-z0-9_])\>/ {
        yield constant.numeric;
    } else if /'/ {
        loop {
            if /[^'\\]+/ {}
            yield string;
            if /\\./ {}
            else if /'/ { yield string; break; }
            else { await input; }
        }
    } else if /"/ {
        loop {
            if /[^"\\]+/ {}
            yield string;
            if /\\./ {}
            else if /"/ { yield string; break; }
            else { await input; }
        }
    } else if /`/ {
        loop {
            yield string;
            if /\\./ {}
            else if /`/ { yield string; break; }
            await input;
        }
    } else if /(?:begin|break|case|class|do|else|elsif|end|ensure|for|if|in|module|next|redo|rescue|retry|return|then|unless|until|when|while)\>/ {
        yield keyword.control;
    } else if /def\s+(?:self|[A-Z]\w*)\.(\w+[!?=]?)/ {
        yield keyword.control;
        yield $1 as method;
    } else if /def\s+(\w+[!?=]?)/ {
        yield keyword.control;
        yield $1 as method;
    } else if /(?:BEGIN|END|alias|defined\?|self|super|undef|yield)\>/ {
        yield keyword.other;
    } else if /(?:true|false|nil)\>/ {
        yield constant.language;
    } else if /\.\.\.?/ {
        // Range operator.
    } else if /(?i:-?(?:0x[\da-fA-F_]+|0b[01_]+|0o[0-7_]+)r?i?)/ {
        if /\w+/ {
            // Invalid numeric literal
        } else {
            yield constant.numeric;
        }
    } else if /(?i:-?[\d_]+\.[\d_]+(?:e[+-]?[\d_]+)?r?i?)/ {
        if /\w+/ {
            // Invalid numeric literal
        } else {
            yield constant.numeric;
        }
    } else if /(?i:-?\.[\d_]+(?:e[+-]?[\d_]+)?r?i?)/ {
        if /\w+/ {
            // Invalid numeric literal
        } else {
            yield constant.numeric;
        }
    } else if /(?i:-?[\d_]+(?:e[+-]?[\d_]+)?r?i?)/ {
        if /\w+/ {
            // Invalid numeric literal
        } else {
            yield constant.numeric;
        }
    } else if /(?:@{1,2}|\$)[A-Za-z_]\w*/ {
        yield variable;
    } else if /:[A-Za-z_]\w*[!?=]?/ {
        yield constant.language;
    } else if /[A-Z]\w*/ {
        yield constant.language;
    } else if /(\w+[!?=]?)\s*\(/ {
        yield $1 as method;
    } else if /\w+[!?=]?/ {
        // Gobble word chars to align the next iteration on a word boundary.
    }
}
