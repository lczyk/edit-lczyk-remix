// Chisel package slices files -- canonical/chisel-releases dialect of
// YAML. Adds dialect highlighting for the structural top-level keys
// (package/essential/slices/contents/mutate) and for slice names (the keys
// nested directly under `slices:`), which get the same highlight as function
// names in other languages. Path glob is intentionally narrow until
// content-based detection lands; once detect() is wired up the glob will
// broaden to **/*.yaml and disambiguation will be content-driven.

// Content sniffer paired with `slice_yaml` by name convention
// (`<entry>_detect`). The resolver runs this against the head of the buffer
// when a path-glob candidate set contains more than one entry. Verdict is
// signalled by `return match;` / `return no_match;`.
//
// Heuristic: the first non-blank non-comment line must be `package: <name>`,
// and within the head budget we must see a top-level `slices:` line. Both are
// universal across the chisel-releases corpus (validated on 654 files at
// scoping time).
fn slice_yaml_detect() {
    if /\s*#.*/ {
        // Skip leading comment lines.
    } else if /\s*$/ {
        // Skip blank lines.
    } else if /package:\s+\S/ {
        // Found the package declaration. Now look for `slices:` further down.
        loop {
            await input;
            if /slices:\s*(?:#.*)?$/ {
                return match;
            }
        }
    } else {
        // Anything else as the first non-blank, non-comment line means this is
        // not a chisel slice file.
        return no_match;
    }
}

// Trailing value handler shared by every key-bearing line: optional scalar
// (string / numeric / boolean / null), optional trailing comment.
fn slice_yaml_value() {
    yield other;

    if /"/ {
        loop {
            if /[^"\\]+/ {}
            yield string;
            if /\\./ {}
            else if /"/ { yield string; break; }
            else { await input; }
        }
    } else if /'/ {
        loop {
            if /[^']+/ {}
            yield string;
            if /''/ {}
            else if /'/ { yield string; break; }
            else { await input; }
        }
    } else if /---/ {
        yield other;
    } else if /true|false|yes|no|null|~/ {
        if /\s*[^\s#]+[^#]*/ {
            yield string;
        } else {
            yield constant.language;
        }
    } else if /-?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/ {
        if /\s*[^\s#]+[^#]*/ {
            yield string;
        } else {
            yield constant.numeric;
        }
    } else if /[^\s#]+[^#]*/ {
        yield string;
    }

    if /\s+/ {
        yield other;
    }

    if /#.*/ {
        yield comment;
    }
}

// Body of one indented line inside a `slices:` block. Indent-2 keys are slice
// names; deeper nested keys are normal yaml, with `essential` / `contents` /
// `mutate` treated as structural keywords.
fn slice_yaml_in_slices_line() {
    var two = 2;

    // The block-scalar branch re-enters this dispatch once the body ends, so
    // the dedented line that closed it is still highlighted as a slice line.
    loop {
        if /\s*$/ {
            // Blank line.
        } else if /\s*#.*/ {
            yield comment;
        } else {
            if /\s+/ {
                yield other;
            }

            var indentation = off;

            if off == two {
                // Exactly two-space indent + key = slice name.
                if /([\w.+*\/-]+):/ {
                    yield $1 as method;
                }
            } else {
                if /-\s+/ {
                    // List item
                }
                if /(?:essential|contents|mutate|hint):(?:\s+|$)/ {
                    yield keyword.other;
                } else if /[\w.+*\/-]+:(?:\s+|$)/ {
                    // Generic Key:
                }
            }

            if /[|>][-+]?\s*$/ {
                yield other;
                loop {
                    await input;
                    if /\s+/ {
                    }
                    if /$/ {
                        // A blank line stays inside the block scalar.
                        yield string;
                        continue;
                    }
                    if off <= indentation {
                        break;
                    }
                    if /.*/ {
                        yield string;
                    }
                }
                continue;
            }

            slice_yaml_value();
        }

        break;
    }
}

#[display_name = "Chisel Slice"]
#[line_comment = "#"]
#[path = "**/*.yaml"]
pub fn slice_yaml() {
    // Per-line entry. Once `slices:` is matched we enter an inner loop that
    // owns every remaining line: in chisel slice files `slices:` is always the
    // last top-level section, so dialect-specific handling never needs to fall
    // back out.

    if /\s+/ {
        yield other;
    }

    if /slices:(?:\s+|$)/ {
        yield keyword.other;
        slice_yaml_value();

        loop {
            await input;
            slice_yaml_in_slices_line();
        }
    } else {
        // A list-item dash and a key are independent: `- key: value` carries
        // both. Keeping the dash a separate `if` (not part of the key's else-if
        // chain) is what lets the key still match after the dash is consumed --
        // otherwise the whole `key: value` falls through to the value handler
        // and gets coloured as a plain string.
        if /-\s+/ {
            // List item at top level
        }
        if /(?:package|essential|contents|mutate|hint):(?:\s+|$)/ {
            yield keyword.other;
        } else if /[\w.+*\/-]+:(?:\s+|$)/ {
            // Generic Key:
        }
    }

    slice_yaml_value();
}
