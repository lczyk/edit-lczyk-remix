\x1b[32m# Control flow keywords\x1b[m
\x1b[95mif\x1b[m \x1b[94mtrue\x1b[m
  puts \x1b[91m"yes"\x1b[m
\x1b[95melsif\x1b[m \x1b[94mfalse\x1b[m
  puts \x1b[91m"no"\x1b[m
\x1b[95melse\x1b[m
  puts \x1b[91m"maybe"\x1b[m
\x1b[95mend\x1b[m

\x1b[95munless\x1b[m \x1b[94mnil\x1b[m
  puts \x1b[91m"not nil"\x1b[m
\x1b[95mend\x1b[m

\x1b[95mcase\x1b[m \x1b[92m42\x1b[m
\x1b[95mwhen\x1b[m \x1b[92m1\x1b[m
  puts \x1b[91m"one"\x1b[m
\x1b[95melse\x1b[m
  puts \x1b[91m"other"\x1b[m
\x1b[95mend\x1b[m

\x1b[95mfor\x1b[m i \x1b[95min\x1b[m \x1b[92m1\x1b[m..\x1b[92m3\x1b[m
  \x1b[95mnext\x1b[m \x1b[95mif\x1b[m i == \x1b[92m2\x1b[m
  \x1b[95mbreak\x1b[m \x1b[95mif\x1b[m i == \x1b[92m3\x1b[m
\x1b[95mend\x1b[m

\x1b[95mwhile\x1b[m \x1b[94mfalse\x1b[m
  \x1b[95mredo\x1b[m
\x1b[95mend\x1b[m

\x1b[95mbegin\x1b[m
  \x1b[95mraise\x1b[m \x1b[91m"oops"\x1b[m
\x1b[95mrescue\x1b[m \x1b[36mStandardError\x1b[m => e
  \x1b[95mretry\x1b[m
\x1b[95mensure\x1b[m
  puts e
\x1b[95mend\x1b[m

\x1b[32m# Definitions and method calls\x1b[m
\x1b[95mmodule\x1b[m \x1b[36mDemo\x1b[m
  \x1b[95mclass\x1b[m \x1b[36mAnimal\x1b[m
    \x1b[95mdef \x1b[m\x1b[93minitialize\x1b[m(name)
      \x1b[96m@name\x1b[m = name
    \x1b[95mend\x1b[m

    \x1b[95mdef \x1b[m\x1b[93mspeak!\x1b[m =  puts \x1b[91m"\x1b[m\x1b[33m#{\x1b[m\x1b[96m@name\x1b[m\x1b[33m}\x1b[m\x1b[91m speaks"\x1b[m
  \x1b[95mend\x1b[m
\x1b[95mend\x1b[m

\x1b[94malias\x1b[m old_speak speak!
\x1b[94mundef\x1b[m old_speak

\x1b[94mBEGIN\x1b[m { puts \x1b[91m"start"\x1b[m }
\x1b[94mEND\x1b[m { puts \x1b[91m"finish"\x1b[m }
