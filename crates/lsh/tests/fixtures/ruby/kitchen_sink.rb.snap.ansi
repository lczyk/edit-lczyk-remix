\x1b[93mgreet\x1b[m(\x1b[91m"world"\x1b[m)

\x1b[32m# Singleton method defs\x1b[m
\x1b[95mclass\x1b[m \x1b[36mFoo\x1b[m
  \x1b[95mdef self.\x1b[m\x1b[93mbar\x1b[m
    \x1b[92m42\x1b[m
  \x1b[95mend\x1b[m

  \x1b[95mdef Foo.\x1b[m\x1b[93mbaz\x1b[m
