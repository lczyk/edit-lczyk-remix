  \x1b[95mend\x1b[m
\x1b[95mend\x1b[m

\x1b[32m# Percent literals\x1b[m
words = \x1b[91m%w[one two three]\x1b[m
syms = \x1b[91m%i[a b c]\x1b[m
str_q = \x1b[91m%q(plain)\x1b[m
str_Q = \x1b[91m%Q{interp}\x1b[m

\x1b[32m# Character literals\x1b[m
ch_a = \x1b[92m?a\x1b[m
ch_z = \x1b[92m?Z\x1b[m
ch_esc = \x1b[92m?\\n\x1b[m

\x1b[32m# Strings carry raw newlines, single- and double-quoted alike.\x1b[m
raw = \x1b[91m'line one\x1b[m
\x1b[91mline two'\x1b[m
esc = \x1b[91m"escaped \x1b[m\x1b[33m\\"\x1b[m\x1b[91m quote\x1b[m
\x1b[91mline two"\x1b[m

\x1b[32m# Heredocs: squiggly, dashed, quoted, and plain. The rest of the opener line\x1b[m
\x1b[32m# is still code; the body starts on the next line.\x1b[m
sql = \x1b[91m<<~SQL\x1b[m.strip
\x1b[91m  SELECT * FROM users\x1b[m
\x1b[91m  WHERE name = 'SQL'\x1b[m
SQL
html = \x1b[91m<<-'HTML'\x1b[m
\x1b[91m    <p>#{not_interpolated}</p>\x1b[m
    HTML
plain = \x1b[91m<<EOS\x1b[m
\x1b[91mEOS mid-line stays body\x1b[m
EOS
puts sql
greeting = \x1b[91m<<~MSG\x1b[m
\x1b[91m  hi \x1b[m\x1b[33m#{\x1b[mname\x1b[33m}\x1b[m\x1b[91m, \x1b[m\x1b[33m\\t\x1b[m\x1b[33m#{\x1b[mitems.map { |i| i * \x1b[92m2\x1b[m }.sum\x1b[33m}\x1b[m\x1b[91m total\x1b[m
MSG

\x1b[32m# Interpolation is code: its quotes and braces don't end the string.\x1b[m
say = \x1b[91m"stop=\x1b[m\x1b[33m#{\x1b[mfinal[\x1b[91m"reason"\x1b[m] || \x1b[91m"?"\x1b[m\x1b[33m}\x1b[m\x1b[91m n=\x1b[m\x1b[33m#{\x1b[mh.\x1b[93mfetch\x1b[m(\x1b[94m:k\x1b[m) { {} }.size\x1b[33m}\x1b[m\x1b[91m"\x1b[m
multi = \x1b[91m"a \x1b[m\x1b[33m#{\x1b[m
  value
\x1b[33m}\x1b[m\x1b[91m b"\x1b[m
tick = \x1b[91m`ls \x1b[m\x1b[33m#{\x1b[mdir\x1b[33m}\x1b[m\x1b[91m`\x1b[m

\x1b[32m# Regexp literals vs division\x1b[m
x = \x1b[91m/\\d+ \x1b[m\x1b[33m#{\x1b[mn\x1b[33m}\x1b[m\x1b[91m \\/ \\w/i\x1b[m
line =~ \x1b[91m/^#/\x1b[m && line !~ \x1b[91m/x/\x1b[m
\x1b[93massert_match\x1b[m(\x1b[91m/nope` not found/\x1b[m, msg)
words.grep \x1b[91m/re/\x1b[m
\x1b[95mwhen\x1b[m \x1b[91m/a|b/\x1b[m
half = total / \x1b[92m2\x1b[m
ratio = a/b
total /= \x1b[92m2\x1b[m

\x1b[32m# Multi-line and nested percent literals\x1b[m
list = \x1b[91m%w[one two\x1b[m
\x1b[91m          three]\x1b[m
rx = \x1b[91m%r{\\d{3}-\\d{4}}\x1b[m

\x1b[32m# Labels, symbols, scope\x1b[m
opts = { \x1b[94min:\x1b[m \x1b[92m1\x1b[m, \x1b[94mclass:\x1b[m \x1b[92m2\x1b[m, \x1b[94mif:\x1b[m \x1b[92m3\x1b[m }
\x1b[93mcall\x1b[m(\x1b[94mkey:\x1b[m v, \x1b[94mother:\x1b[m \x1b[92m1\x1b[m)
\x1b[95mdef \x1b[m\x1b[93mkw\x1b[m(\x1b[94ma:\x1b[m, \x1b[94mb:\x1b[m \x1b[92m1\x1b[m) \x1b[95mend\x1b[m
pick = flag ? left : right
\x1b[36mFoo\x1b[m::\x1b[36mBar\x1b[m
sum = xs.\x1b[93mreduce\x1b[m(\x1b[94m:+\x1b[m)
sorted = xs.\x1b[93msort_by\x1b[m(&\x1b[94m:size\x1b[m)

\x1b[32m# Method names after a dot are never keywords\x1b[m
x.class
x.nil?
x.then { _1 }

\x1b[32m# Underscores and globals\x1b[m
a, _, c = triple
\x1b[96m$stderr\x1b[m.puts \x1b[96m$0\x1b[m, \x1b[96m$!\x1b[m

\x1b[32m# Block params\x1b[m
xs.each { |\x1b[96mk, v\x1b[m| p k }
xs.each_with_index \x1b[95mdo\x1b[m |\x1b[96mitem, i\x1b[m|
\x1b[95mend\x1b[m

