      <\x1b[94mp\x1b[m>Use <%%= foo %> to print an ERB tag literally.</\x1b[94mp\x1b[m>
      \x1b[32m<%# a short single-line comment, unlike the multi-line one above %>\x1b[m

      \x1b[94m<%\x1b[m
        \x1b[96m@greeting\x1b[m = \x1b[91m"hello, #{@user.name}"\x1b[m
        \x1b[96m@count\x1b[m = \x1b[96m@items\x1b[m.size
      \x1b[94m%>\x1b[m
      <\x1b[94mp\x1b[m>\x1b[94m<%=\x1b[m \x1b[96m@greeting\x1b[m \x1b[94m%>\x1b[m \x1b[92m&mdash;\x1b[m you have \x1b[94m<%=\x1b[m \x1b[96m@count\x1b[m \x1b[94m%>\x1b[m items.</\x1b[94mp\x1b[m>

      \x1b[94m<%\x1b[m \x1b[95mif\x1b[m \x1b[96m@items\x1b[m.empty? \x1b[94m%>\x1b[m
        <\x1b[94mp\x1b[m \x1b[96mclass\x1b[m=\x1b[91m"empty"\x1b[m>Nothing here yet.</\x1b[94mp\x1b[m>
      \x1b[94m<%\x1b[m \x1b[95melse\x1b[m \x1b[94m%>\x1b[m
        <\x1b[94mul\x1b[m \x1b[96mclass\x1b[m=\x1b[91m"item-list"\x1b[m>
          \x1b[94m<%\x1b[m \x1b[96m@items\x1b[m.each \x1b[95mdo\x1b[m |item| \x1b[94m%>\x1b[m
            <\x1b[94mli\x1b[m \x1b[96mid\x1b[m=\x1b[91m"item-\x1b[m\x1b[94m<%=\x1b[m item.id \x1b[94m%>\x1b[m\x1b[91m"\x1b[m \x1b[96mclass\x1b[m=\x1b[91m"\x1b[m\x1b[94m<%=\x1b[m item.active? ? \x1b[91m"active"\x1b[m : \x1b[91m"inactive"\x1b[m \x1b[94m%>\x1b[m\x1b[91m"\x1b[m>
              \x1b[94m<%=\x1b[m link_to item.name, \x1b[93mitem_path\x1b[m(item), \x1b[95mclass\x1b[m: \x1b[91m"item-link"\x1b[m, data: { turbo: \x1b[94mtrue\x1b[m } \x1b[95mdo\x1b[m \x1b[94m%>\x1b[m
                <\x1b[94mspan\x1b[m \x1b[96mclass\x1b[m=\x1b[91m"item-name"\x1b[m>\x1b[94m<%=\x1b[m item.name \x1b[94m%>\x1b[m</\x1b[94mspan\x1b[m>
                <\x1b[94mem\x1b[m>(\x1b[94m<%=\x1b[m item.count \x1b[94m%>\x1b[m)</\x1b[94mem\x1b[m>
              \x1b[94m<%\x1b[m \x1b[95mend\x1b[m \x1b[94m%>\x1b[m
            </\x1b[94mli\x1b[m>
          \x1b[94m<%\x1b[m \x1b[95mend\x1b[m \x1b[94m%>\x1b[m
        </\x1b[94mul\x1b[m>
      \x1b[94m<%\x1b[m \x1b[95mend\x1b[m \x1b[94m%>\x1b[m

