  \x1b[96msrc\x1b[m: \x1b[33murl\x1b[m(\x1b[91mfonts/example.woff2\x1b[m) \x1b[33mformat\x1b[m(\x1b[91m"woff2"\x1b[m),
       \x1b[33murl\x1b[m(\x1b[91m"fonts/example.woff"\x1b[m) \x1b[33mformat\x1b[m(\x1b[91m'woff'\x1b[m);
  \x1b[96mfont-weight\x1b[m: \x1b[92m100\x1b[m \x1b[92m800\x1b[m;
}

