  \x1b[96mpadding\x1b[m: \x1b[92m3px\x1b[m \x1b[33mclamp\x1b[m(\x1b[92m1rem\x1b[m, \x1b[92m2.5vw\x1b[m, \x1b[92m2rem\x1b[m);
  \x1b[96mwidth\x1b[m: \x1b[33mcalc\x1b[m(\x1b[92m100%\x1b[m - \x1b[33mvar\x1b[m(\x1b[96m--gap\x1b[m));
}

\x1b[94ma\x1b[m\x1b[94m:hover\x1b[m,
\x1b[94ma\x1b[m\x1b[94m:focus-visible\x1b[m {
