\x1b[94ma\x1b[m[\x1b[96mclass\x1b[m*=\x1b[91m"btn"\x1b[m], \x1b[94ma\x1b[m[\x1b[96mhref\x1b[m^=\x1b[91m"https://"\x1b[m], \x1b[94ma\x1b[m[\x1b[96mhref\x1b[m$=\x1b[91m".pdf"\x1b[m] {
