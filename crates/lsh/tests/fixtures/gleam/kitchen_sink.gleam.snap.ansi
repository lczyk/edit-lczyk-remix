\x1b[32m//// Module doc comment: four slashes, distinct from the doc comment below.\x1b[m

\x1b[94mimport\x1b[m gleam/int
\x1b[94mimport\x1b[m gleam/list
\x1b[94mimport\x1b[m gleam/string

\x1b[32m/// Doc comment: three slashes.\x1b[m
\x1b[32m/// Spans several lines.\x1b[m
\x1b[32m// Plain line comment.\x1b[m

\x1b[94mpub\x1b[m \x1b[94mtype\x1b[m \x1b[96mShape\x1b[m {
  \x1b[96mCircle\x1b[m(radius: \x1b[36mFloat\x1b[m)
  \x1b[96mRectangle\x1b[m(width: \x1b[36mFloat\x1b[m, height: \x1b[36mFloat\x1b[m)
}

\x1b[94mpub\x1b[m \x1b[94mopaque\x1b[m \x1b[94mtype\x1b[m \x1b[96mCounter\x1b[m {
  \x1b[96mCounter\x1b[m(count: \x1b[36mInt\x1b[m)
}

\x1b[94mpub\x1b[m \x1b[94mconst\x1b[m greeting: \x1b[36mString\x1b[m = \x1b[91m"hello"\x1b[m

\x1b[94mconst\x1b[m limit = \x1b[92m100\x1b[m

\x1b[4m@external\x1b[m(erlang, \x1b[91m"lists"\x1b[m, \x1b[91m"reverse"\x1b[m)
\x1b[4m@deprecated\x1b[m(\x1b[91m"use list.reverse instead"\x1b[m)
\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mreverse\x1b[m(items: \x1b[36mList\x1b[m(a)) -> \x1b[36mList\x1b[m(a)

\x1b[4m@target\x1b[m(javascript)
\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93marea\x1b[m(shape: \x1b[96mShape\x1b[m) -> \x1b[36mFloat\x1b[m {
  \x1b[95mcase\x1b[m shape {
    \x1b[96mCircle\x1b[m(radius) -> \x1b[92m3.14159\x1b[m *. radius *. radius
    \x1b[96mRectangle\x1b[m(width, height) -> width *. height
  }
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mclassify\x1b[m(n: \x1b[36mInt\x1b[m) -> \x1b[36mResult\x1b[m(\x1b[36mString\x1b[m, \x1b[36mString\x1b[m) {
  \x1b[95mcase\x1b[m n {
    \x1b[92m0\x1b[m -> \x1b[94mOk\x1b[m(\x1b[91m"zero"\x1b[m)
    \x1b[96m_\x1b[m \x1b[95mif\x1b[m n < \x1b[92m0\x1b[m -> \x1b[94mError\x1b[m(\x1b[91m"negative"\x1b[m)
    \x1b[96m_\x1b[m -> \x1b[94mOk\x1b[m(\x1b[91m"positive"\x1b[m)
  }
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mescapes\x1b[m() -> \x1b[36mString\x1b[m {
  \x1b[94mlet\x1b[m quoted = \x1b[91m"a \\"quoted\\" word"\x1b[m
  \x1b[94mlet\x1b[m escaped = \x1b[91m"tab:\\t newline:\\n return:\\r formfeed:\\f backslash:\\\\"\x1b[m
  \x1b[94mlet\x1b[m codepoint = \x1b[91m"snowman \\u{2603} and \\u{1F600}"\x1b[m
  \x1b[94mlet\x1b[m unknown = \x1b[91m"not a real escape: \\q"\x1b[m
  string.\x1b[93mconcat\x1b[m([quoted, escaped, codepoint, unknown])
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mnumbers\x1b[m() -> \x1b[36mList\x1b[m(\x1b[36mInt\x1b[m) {
  \x1b[94mlet\x1b[m hex = \x1b[92m0xDEADbeef\x1b[m
  \x1b[94mlet\x1b[m octal = \x1b[92m0o755\x1b[m
  \x1b[94mlet\x1b[m binary = \x1b[92m0b1010_1010\x1b[m
  \x1b[94mlet\x1b[m decimal = \x1b[92m1_000_000\x1b[m
  \x1b[94mlet\x1b[m negative = \x1b[92m-42\x1b[m
  \x1b[94mlet\x1b[m float = \x1b[92m3.14\x1b[m
  \x1b[94mlet\x1b[m exponent = \x1b[92m6.022e23\x1b[m
  \x1b[94mlet\x1b[m small = \x1b[92m1.6e-19\x1b[m
  \x1b[32m// Digits immediately followed by word characters are not a valid\x1b[m
  \x1b[32m// literal, so they must not highlight as numeric.\x1b[m
  \x1b[94mlet\x1b[m invalid = 123abc
  [hex, octal, binary, decimal, negative]
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mdiscards\x1b[m() -> \x1b[94mNil\x1b[m {
  \x1b[94mlet\x1b[m \x1b[96m_\x1b[m = \x1b[91m"wholly discarded"\x1b[m
  \x1b[94mlet\x1b[m \x1b[96m_unused\x1b[m = \x1b[92m1\x1b[m
  \x1b[94mlet\x1b[m \x1b[95massert\x1b[m \x1b[94mOk\x1b[m(value) = \x1b[93mclassify\x1b[m(\x1b[92m1\x1b[m)
  \x1b[95mecho\x1b[m value
  \x1b[94mNil\x1b[m
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mbooleans\x1b[m() -> \x1b[36mBool\x1b[m {
  \x1b[94mlet\x1b[m yes = \x1b[94mTrue\x1b[m
  \x1b[94mlet\x1b[m no = \x1b[94mFalse\x1b[m
  yes && !no
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mtypes\x1b[m() -> \x1b[94mNil\x1b[m {
  \x1b[94mlet\x1b[m a: \x1b[36mInt\x1b[m = \x1b[92m1\x1b[m
  \x1b[94mlet\x1b[m b: \x1b[36mFloat\x1b[m = \x1b[92m2.0\x1b[m
  \x1b[94mlet\x1b[m c: \x1b[36mString\x1b[m = \x1b[91m"three"\x1b[m
  \x1b[94mlet\x1b[m d: \x1b[36mBool\x1b[m = \x1b[94mTrue\x1b[m
  \x1b[94mlet\x1b[m e: \x1b[36mList\x1b[m(\x1b[36mInt\x1b[m) = [\x1b[92m1\x1b[m, \x1b[92m2\x1b[m, \x1b[92m3\x1b[m]
  \x1b[94mlet\x1b[m f: \x1b[36mResult\x1b[m(\x1b[36mInt\x1b[m, \x1b[94mNil\x1b[m) = \x1b[94mOk\x1b[m(\x1b[92m1\x1b[m)
  \x1b[94mlet\x1b[m g: \x1b[36mBitArray\x1b[m = <<\x1b[92m1\x1b[m, \x1b[92m2\x1b[m, \x1b[92m3\x1b[m>>
  \x1b[94mlet\x1b[m h: \x1b[36mDynamic\x1b[m = dynamic.\x1b[93mfrom\x1b[m(\x1b[92m1\x1b[m)
  \x1b[94mlet\x1b[m i: \x1b[36mUtfCodepoint\x1b[m = codepoint
  \x1b[94mNil\x1b[m
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mcontrol\x1b[m(items: \x1b[36mList\x1b[m(\x1b[36mInt\x1b[m)) -> \x1b[36mInt\x1b[m {
  \x1b[95muse\x1b[m item <- list.\x1b[93mmap\x1b[m(items)
  \x1b[95mcase\x1b[m item {
    \x1b[92m0\x1b[m -> \x1b[95mpanic\x1b[m \x1b[95mas\x1b[m \x1b[91m"zero is not allowed"\x1b[m
    \x1b[92m1\x1b[m -> \x1b[95mtodo\x1b[m \x1b[95mas\x1b[m \x1b[91m"not implemented yet"\x1b[m
    \x1b[96m_\x1b[m -> item
  }
}

\x1b[94mpub\x1b[m \x1b[94mtype\x1b[m \x1b[96mAnimal\x1b[m {
  \x1b[96mDog\x1b[m
  \x1b[96mCat\x1b[m
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93msound\x1b[m(animal: \x1b[96mAnimal\x1b[m) -> \x1b[36mString\x1b[m {
  \x1b[95mcase\x1b[m animal {
    \x1b[96mDog\x1b[m -> \x1b[91m"woof"\x1b[m
    \x1b[96mCat\x1b[m -> \x1b[91m"meow"\x1b[m
  }
}

\x1b[94mpub\x1b[m \x1b[94mfn\x1b[m \x1b[93mmain\x1b[m() {
  \x1b[94mlet\x1b[m shapes = [\x1b[96mCircle\x1b[m(\x1b[92m1.0\x1b[m), \x1b[96mRectangle\x1b[m(\x1b[92m2.0\x1b[m, \x1b[92m3.0\x1b[m)]
  list.\x1b[93mmap\x1b[m(shapes, area)
  |> list.\x1b[93meach\x1b[m(io.debug)
}

\x1b[32m// A string literal may carry a raw newline.\x1b[m
\x1b[94mconst\x1b[m span = \x1b[91m"line one\x1b[m
\x1b[91mline two"\x1b[m

